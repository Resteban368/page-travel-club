# URL pública de la web (tu dominio). Se usa para canonical, sitemap, Open Graph y JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.travelclubagencia.com

# API de NestJS (solo servidor, nunca se expone al navegador)
API_URL=https://cotizaciones.travelclubagencia.com
# Opcional: se envía como header "x-api-key" a tu API
API_KEY=

# Secreto compartido con NestJS para el webhook POST /api/revalidate
REVALIDATE_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio

# Opcional: hosts extra de imágenes remotas, separados por coma (api-travel-tours.vercel.app ya está permitido)
IMAGES_HOST=
